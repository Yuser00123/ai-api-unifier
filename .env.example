# Server
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Personal gateway authentication. Never commit the real value.
GATEWAY_API_KEY=replace-with-a-long-random-token
INTERNAL_JOB_TOKEN=replace-with-another-long-random-token

# Persistent services. If DATABASE_URL is empty, the app uses in-memory storage.
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379

# Provider credentials. Leave providers you do not use empty.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# Optional base URL overrides for testing, private endpoints, or compatible gateways.
OPENROUTER_BASE_URL=
GEMINI_BASE_URL=
GROQ_BASE_URL=
NVIDIA_BASE_URL=
MISTRAL_BASE_URL=
COHERE_BASE_URL=

# Optional provider routing. Each item is provider:model, in priority order.
# Provider names: openrouter, gemini, groq, nvidia, mistral, cohere.
ROUTE_FAST=groq:llama-3.3-70b-versatile,gemini:gemini-2.5-flash,mistral:mistral-small-latest,openrouter:openai/gpt-4o-mini
ROUTE_BALANCED=gemini:gemini-2.5-flash,mistral:mistral-medium-latest,groq:llama-3.3-70b-versatile,openrouter:openai/gpt-4o-mini
ROUTE_REASONING=gemini:gemini-2.5-pro,mistral:mistral-large-latest,nvidia:moonshotai/kimi-k2.5,openrouter:anthropic/claude-sonnet-4
ROUTE_LONG_CONTEXT=gemini:gemini-2.5-pro,openrouter:google/gemini-2.5-pro
ROUTE_CHEAP_SUMMARY=groq:llama-3.1-8b-instant,gemini:gemini-2.5-flash,mistral:mistral-small-latest
DEFAULT_ROUTE=balanced
SUMMARY_ROUTE=cheap-summary

# Reliability and context controls
REQUEST_TIMEOUT_MS=90000
RETRY_ATTEMPTS=2
RETRY_BASE_DELAY_MS=300
CONTEXT_BUDGET_TOKENS=12000
RECENT_MESSAGE_LIMIT=36
SUMMARY_TRIGGER_MESSAGES=40
MAX_MEMORY_RESULTS=12
MAX_BODY_BYTES=2097152

# Optional embeddings. The default is disabled; long-term search still works with keyword matching.
# For an OpenAI-compatible embeddings provider, set both values and use a 1536-dimensional model.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# Optional OpenRouter metadata
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Unified AI Memory Gateway
